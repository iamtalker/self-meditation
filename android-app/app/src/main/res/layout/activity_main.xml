<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- New-version banner (shown only when an update is available) -->
        <LinearLayout
            android:id="@+id/updateBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#CDEBE5"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/updateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#00382F"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/updateStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#00382F"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/updateProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="셀프 메디테이션"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="대기 중"
            android:textSize="16sp" />

        <!-- Sound -->
        <TextView
            style="@style/Section"
            android:text="소리 종류" />

        <RadioGroup
            android:id="@+id/soundGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/soundGong"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="징" />

            <RadioButton
                android:id="@+id/soundBell"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="벨" />

            <RadioButton
                android:id="@+id/soundWood"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="목탁" />

            <RadioButton
                android:id="@+id/soundDrum"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="북" />

            <RadioButton
                android:id="@+id/soundDeep"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="저음" />
        </RadioGroup>

        <TextView
            android:id="@+id/pitchLabel"
            style="@style/Label" />

        <SeekBar
            android:id="@+id/pitchSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30" />

        <TextView
            android:id="@+id/decayLabel"
            style="@style/Label" />

        <SeekBar
            android:id="@+id/decaySeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30" />

        <Button
            android:id="@+id/previewButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="소리 미리듣기" />

        <!-- Rhythm -->
        <TextView
            style="@style/Section"
            android:text="박자" />

        <TextView
            android:id="@+id/bpmLabel"
            style="@style/Label" />

        <SeekBar
            android:id="@+id/bpmSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="19" />

        <!-- Time -->
        <TextView
            style="@style/Section"
            android:text="시간 (분)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Label"
                    android:text="유도 (박자가 또렷함)" />

                <EditText
                    android:id="@+id/inductionEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Label"
                    android:text="유지 (스스로 이어 감)" />

                <EditText
                    android:id="@+id/maintenanceEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="3" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Section"
            android:text="유지 단계의 박자" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/modeNone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="없음" />

            <RadioButton
                android:id="@+id/modeFaint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="약하게" />

            <RadioButton
                android:id="@+id/modeSame"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="그대로" />
        </RadioGroup>

        <Button
            android:id="@+id/playButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="시작" />

        <!-- App update -->
        <TextView
            style="@style/Section"
            android:text="앱 업데이트" />

        <TextView
            android:id="@+id/versionText"
            style="@style/Label" />

        <Button
            android:id="@+id/checkUpdateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="업데이트 확인" />

        <TextView
            android:id="@+id/checkedText"
            style="@style/Label" />

        <CheckBox
            android:id="@+id/autoUpdateCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="앱을 열 때 새 버전 자동 확인 (6시간마다)" />
    </LinearLayout>
</ScrollView>
